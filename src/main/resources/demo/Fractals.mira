module Fractals;

import native "raylib.jar" as ray;
import math as m;
import collection as c;
import thread as thread;
import map as mp;

const MAX_ITER : 80;

const COARSE : 8;

const THREADS : 16;

var gMu : thread.newMutex();

var gNextRow : 0;

var gResults : null;

fn mandelbrot(cr, ci, maxIter) {
    var a : (cr - 0.25);
    var q : (a * a + ci * ci);
    if ((q * (q + a)) < (ci * ci * 0.25)) {
        return 0;
    }
    var b : (cr + 1.0);
    if ((b * b + ci * ci) < 0.0625) {
        return 0;
    }
    var zr : 0.0;
    var zi : 0.0;
    var i : 0;
    while (i < maxIter) {
        var zr2 : (zr * zr);
        var zi2 : (zi * zi);
        if ((zr2 + zi2) > 4.0) {
            return i;
        }
        var newZr : (zr2 - zi2 + cr);
        zi : (2.0 * zr * zi + ci);
        zr : newZr;
        i++;
    }
    return 0;
}

fn julia(zr, zi, cr, ci, maxIter) {
    var i : 0;
    while (i < maxIter) {
        var zr2 : (zr * zr);
        var zi2 : (zi * zi);
        if ((zr2 + zi2) > 4.0) {
            return i;
        }
        var newZr : (zr2 - zi2 + cr);
        zi : (2.0 * zr * zi + ci);
        zr : newZr;
        i++;
    }
    return 0;
}

fn newton(zr, zi, maxIter, ncr, nci) {
    var i : 0;
    var iters : 0;
    while (i < maxIter) {
        var zr2 : (zr * zr);
        var zi2 : (zi * zi);
        var z3r : (zr * (zr2 - 3.0 * zi2));
        var z3i : (zi * (3.0 * zr2 - zi2));
        var nr : (2.0 * z3r + 1.0);
        var ni : (2.0 * z3i);
        var dr : (3.0 * (zr2 - zi2));
        var di : (6.0 * zr * zi);
        var denom : (dr * dr + di * di);
        iters++;

        if (denom > 0.0000000001) {
            var newZr : ((nr * dr + ni * di) / denom + ncr);
            var newZi : ((ni * dr - nr * di) / denom + nci);
            var diffR : (newZr - zr);
            var diffI : (newZi - zi);
            zr : newZr;
            zi : newZi;
            if ((diffR * diffR + diffI * diffI) < 0.0000000001) {
                i : maxIter;
            } else {
                i++;
            }
        } else {
            i : maxIter;
        }
    }
    var d0 : ((zr - 1.0) * (zr - 1.0) + zi * zi);
    var d1 : ((zr + 0.5) * (zr + 0.5) + (zi - 0.866025) * (zi - 0.866025));
    var d2 : ((zr + 0.5) * (zr + 0.5) + (zi + 0.866025) * (zi + 0.866025));
    if (d0 < d1 && d0 < d2) {
        return iters;
    }
    if (d1 < d2) {
        return (maxIter + iters);
    }
    return (maxIter * 2 + iters);
}

fn buildPalette(maxIter, offset) {
    var pal : c.newList();
    c.push(pal, ray.Color(0, 0, 0, 255));

    for (var i : 1; i <= maxIter; i++) {
        var tp : ((i + offset) * 0.05 * m.pi * 2.0);
        var r : (m.sin(tp) * 127.5 + 127.5);
        var g : (m.sin((tp + 2.094)) * 127.5 + 127.5);
        var b : (m.sin((tp + 4.189)) * 127.5 + 127.5);
        c.push(pal, ray.Color(m.clamp(r, 0, 255), m.clamp(g, 0, 255), m.clamp(b, 0, 255), 255));
    }
    return pal;
}

fn buildNewtonPalette(maxIter, offset) {
    var pal : c.newList();
    c.push(pal, ray.Color(0, 0, 0, 255));

    for (var root : 0; root < 3; root++) {
        var baseAngle : (root * 2.094395 + offset * 0.05);
        for (var i : 1; i <= maxIter; i++) {
            var bri : ((maxIter - i + 1.0) / maxIter);
            var r : (m.sin(baseAngle) * 127.5 * bri + 127.5 * bri);
            var g : (m.sin((baseAngle + 2.094)) * 127.5 * bri + 127.5 * bri);
            var b : (m.sin((baseAngle + 4.189)) * 127.5 * bri + 127.5 * bri);
            c.push(pal, ray.Color(m.clamp(r, 0, 255), m.clamp(g, 0, 255), m.clamp(b, 0, 255), 255));
        }
    }
    return pal;
}

async fn worker(cx, cy, zoom, step, maxIter, w, h, isJulia, jre, jim, isNewton, ncr, nci) {
    var scaleX : (zoom * 2.0 / w);
    var scaleY : (zoom * 2.0 / h);
    var stepX : (scaleX * step);
    var halfW : (w * 0.5);
    var halfH : (h * 0.5);

    while (true) {
        var py : -1;
        lock (gMu) {
            if (gNextRow < h) {
                py : gNextRow;
                gNextRow : (gNextRow + step);
            }
        }
        if (py < 0) {
            return;
        }

        var ci : (cy + (py - halfH) * scaleY);
        var row : c.newList();
        var cr : (cx - halfW * scaleX);
        for (var px : 0; px < w; px +: step) {
            var iters : 0;
            if (isNewton) {
                iters : newton(cr, ci, maxIter, ncr, nci);
            } else if (isJulia) {
                iters : julia(cr, ci, jre, jim, maxIter);
            } else {
                iters : mandelbrot(cr, ci, maxIter);
            }
            c.push(row, iters);

            cr +: stepX;
        }

        lock (gMu) {
            mp.mapSet(gResults, py, row);
        }
    }
}

fn render(tex, cx, cy, zoom, step, maxIter, w, h, pal, isJulia, jre, jim, isNewton, ncr, nci) {
    lock (gMu) {
        gNextRow : 0;
        gResults : mp.newMap();
    }

    var handles : c.newList();
    for (var t : 0; t < THREADS; t++) {
        c.push(handles, worker(cx, cy, zoom, step, maxIter, w, h, isJulia, jre, jim, isNewton, ncr, nci));
    }
    for (var t : 0; t < THREADS; t++) {
        await handles[t];
    }
    ray.BeginTextureMode(tex);
    ray.ClearBackground(ray.Color(0, 0, 0, 255));

    for (var py : 0; py < h; py +: step) {
        var row : mp.mapGet(gResults, py);
        if (row != null) {
            var px : 0;
            for (var iters in row) {
                ray.DrawRectangle(px, py, step, step, pal[iters]);

                px : (px + step);
            }
        }
    }
    ray.EndTextureMode();
}

pub fn run() {
    ray.SetConfigFlags(ray.FLAG_WINDOW_RESIZABLE);
    ray.InitWindow(800, 600, "Fractals");
    ray.SetTargetFPS(60);

    var width : 800;
    var height : 600;

    var view : {
        var cx : -0.5;
        var cy : 0.0;
        var zoom : 2.0;
        var maxIter : MAX_ITER;
        var step : 4;
        var isJulia : false;
        var jre : -0.7;
        var jim : 0.27015;
        var juliaLocked : false;
        var isNewton : false;
        var ncr : 0.0;
        var nci : 0.0;
        var newtonLocked : false;
        var colorCycle : false;
        var cycleTime : 0.0;
    };

    var palette : buildPalette(view.maxIter, 0.0);
    var lastIter : view.maxIter;
    var lastIsNewton : false;
    var tex : ray.LoadRenderTexture(width, height);
    var dirty : true;
    var needRefine : false;
    var lastMx : -1;
    var lastMy : -1;

    while (!ray.WindowShouldClose()) {
        if (ray.IsWindowResized()) {
            width : ray.GetScreenWidth();
            height : ray.GetScreenHeight();
            ray.UnloadRenderTexture(tex);

            tex : ray.LoadRenderTexture(width, height);
            dirty : true;
        }

        var wheel : ray.GetMouseWheelMove();
        if (wheel > 0) {
            var mx : ray.GetMouseX();
            var my : ray.GetMouseY();
            var halfW : (width * 0.5);
            var halfH : (height * 0.5);
            var sx : (view.zoom * 2.0 / width);
            var sy : (view.zoom * 2.0 / height);
            var mre : (view.cx + (mx - halfW) * sx);
            var mim : (view.cy + (my - halfH) * sy);
            view.zoom : (view.zoom * 0.8);
            var sx2 : (view.zoom * 2.0 / width);
            var sy2 : (view.zoom * 2.0 / height);
            view.cx : (mre - (mx - halfW) * sx2);
            view.cy : (mim - (my - halfH) * sy2);
            dirty : true;
        } else if (wheel < 0) {
            view.zoom : (view.zoom * 1.25);
            dirty : true;
        }

        var panSpeed : (view.zoom * 0.03);
        if (ray.IsKeyDown(ray.KEY_LEFT)) {
            view.cx : (view.cx - panSpeed);
            dirty : true;
        }
        if (ray.IsKeyDown(ray.KEY_RIGHT)) {
            view.cx : (view.cx + panSpeed);
            dirty : true;
        }
        if (ray.IsKeyDown(ray.KEY_UP)) {
            view.cy : (view.cy - panSpeed);
            dirty : true;
        }
        if (ray.IsKeyDown(ray.KEY_DOWN)) {
            view.cy : (view.cy + panSpeed);
            dirty : true;
        }

        if (ray.IsKeyPressed(ray.KEY_J)) {
            if (view.isJulia) {
                view.isJulia : false;
                view.cx : -0.5;
                view.cy : 0.0;
                view.zoom : 2.0;
            } else {
                view.isNewton : false;
                view.isJulia : true;
                view.juliaLocked : false;
                view.cx : 0.0;
                view.cy : 0.0;
                view.zoom : 2.0;
                lastMx : -1;
                lastMy : -1;
            }
            dirty : true;
        }

        if (ray.IsKeyPressed(ray.KEY_N)) {
            if (view.isNewton) {
                view.isNewton : false;
                view.cx : -0.5;
                view.cy : 0.0;
                view.zoom : 2.0;
            } else {
                view.isJulia : false;
                view.isNewton : true;
                view.ncr : 0.0;
                view.nci : 0.0;
                view.newtonLocked : false;
                view.cx : 0.0;
                view.cy : 0.0;
                view.zoom : 2.0;
                lastMx : -1;
                lastMy : -1;
            }
            dirty : true;
        }

        if (view.isJulia) {
            if (ray.IsMouseButtonPressed(ray.MOUSE_BUTTON_LEFT)) {
                if (view.juliaLocked) {
                    view.juliaLocked : false;
                    lastMx : -1;
                    lastMy : -1;
                } else {
                    view.juliaLocked : true;
                }
            }
            if (!view.juliaLocked) {
                var mx : ray.GetMouseX();
                var my : ray.GetMouseY();
                if (mx != lastMx || my != lastMy) {
                    lastMx : mx;
                    lastMy : my;
                    var halfW : (width * 0.5);
                    var halfH : (height * 0.5);
                    var sx : (view.zoom * 2.0 / width);
                    var sy : (view.zoom * 2.0 / height);
                    view.jre : (view.cx + (mx - halfW) * sx);
                    view.jim : (view.cy + (my - halfH) * sy);
                    dirty : true;
                }
            }
        }

        if (view.isNewton) {
            if (ray.IsMouseButtonPressed(ray.MOUSE_BUTTON_LEFT)) {
                if (view.newtonLocked) {
                    view.newtonLocked : false;
                    lastMx : -1;
                    lastMy : -1;
                } else {
                    view.newtonLocked : true;
                }
            }
            if (!view.newtonLocked) {
                var mx : ray.GetMouseX();
                var my : ray.GetMouseY();
                if (mx != lastMx || my != lastMy) {
                    lastMx : mx;
                    lastMy : my;
                    var halfW : (width * 0.5);
                    var halfH : (height * 0.5);
                    var sx : (view.zoom * 2.0 / width);
                    var sy : (view.zoom * 2.0 / height);
                    view.ncr : (view.cx + (mx - halfW) * sx);
                    view.nci : (view.cy + (my - halfH) * sy);
                    dirty : true;
                }
            }
        }

        if (ray.IsKeyPressed(ray.KEY_C)) {
            if (view.colorCycle) {
                view.colorCycle : false;
                view.cycleTime : 0.0;
                if (view.isNewton) {
                    palette : buildNewtonPalette(view.maxIter, 0.0);
                } else {
                    palette : buildPalette(view.maxIter, 0.0);
                }
            } else {
                view.colorCycle : true;
            }
            dirty : true;
        }

        if (ray.IsKeyPressed(ray.KEY_I) || ray.IsKeyPressed(ray.KEY_KP_ADD)) {
            view.maxIter : (view.maxIter + 10);
            dirty : true;
        }
        if (ray.IsKeyPressed(ray.KEY_U) || ray.IsKeyPressed(ray.KEY_KP_SUBTRACT)) {
            view.maxIter : (view.maxIter - 10);
            if (view.maxIter < 10) {
                view.maxIter : 10;
            }
            dirty : true;
        }

        if (ray.IsKeyPressed(ray.KEY_PAGE_UP)) {
            view.step : (view.step / 2);
            if (view.step < 1) {
                view.step : 1;
            }
            dirty : true;
        }
        if (ray.IsKeyPressed(ray.KEY_PAGE_DOWN)) {
            view.step : (view.step * 2);
            if (view.step > 16) {
                view.step : 16;
            }
            dirty : true;
        }

        if (ray.IsKeyPressed(ray.KEY_R)) {
            view.cx : -0.5;
            view.cy : 0.0;
            view.zoom : 2.0;
            view.maxIter : MAX_ITER;
            view.step : 4;
            view.isJulia : false;
            view.jre : -0.7;
            view.jim : 0.27015;
            view.juliaLocked : false;
            view.isNewton : false;
            view.ncr : 0.0;
            view.nci : 0.0;
            view.newtonLocked : false;
            view.colorCycle : false;
            view.cycleTime : 0.0;
            lastMx : -1;
            lastMy : -1;
            dirty : true;
        }

        if (view.colorCycle) {
            view.cycleTime : (view.cycleTime + 0.5);
            if (view.isNewton) {
                palette : buildNewtonPalette(view.maxIter, view.cycleTime);
            } else {
                palette : buildPalette(view.maxIter, view.cycleTime);
            }
            lastIter : view.maxIter;
            lastIsNewton : view.isNewton;
            render(tex, view.cx, view.cy, view.zoom, view.step, view.maxIter, width, height, palette, view.isJulia, view.jre, view.jim, view.isNewton, view.ncr, view.nci);
            dirty : false;
            needRefine : false;
        } else {
            if (view.maxIter != lastIter || view.isNewton != lastIsNewton) {
                if (view.isNewton) {
                    palette : buildNewtonPalette(view.maxIter, 0.0);
                } else {
                    palette : buildPalette(view.maxIter, 0.0);
                }
                lastIter : view.maxIter;
                lastIsNewton : view.isNewton;
            }
            var coarseStep : view.step < COARSE ? COARSE : view.step;
            if (dirty) {
                render(tex, view.cx, view.cy, view.zoom, coarseStep, view.maxIter, width, height, palette, view.isJulia, view.jre, view.jim, view.isNewton, view.ncr, view.nci);
                dirty : false;
                needRefine : view.step < coarseStep;
            } else if (needRefine) {
                render(tex, view.cx, view.cy, view.zoom, view.step, view.maxIter, width, height, palette, view.isJulia, view.jre, view.jim, view.isNewton, view.ncr, view.nci);
                needRefine : false;
            }
        }
        ray.BeginDrawing();
        ray.ClearBackground(ray.Color(0, 0, 0, 255));

        var negH : (0 - height);
        ray.DrawTextureRec(ray.GetRenderTextureTexture(tex), ray.Rectangle(0, 0, width, negH), ray.Vector2(0, 0), ray.WHITE);
        ray.DrawFPS(10, 10);

        var helpY : (height - 75);
        var help2Y : (height - 55);
        var info1Y : (height - 35);
        var infoY : (height - 15);
        if (view.isNewton) {
            ray.DrawText("NOVA/NEWTON  Scroll/Arrows: nav   I/U: iter   PgUp/PgDn: res   N: Mandelbrot   J: Julia   C: color cycle   R: reset   ESC: quit", 10, helpY, 14, ray.SKYBLUE);

            if (view.newtonLocked) {
                ray.DrawText("Click: unlock mouse tracking   [LOCKED]", 10, help2Y, 14, ray.ORANGE);
            } else {
                ray.DrawText("Mouse controls Nova c   Click: lock", 10, help2Y, 14, ray.SKYBLUE);
            }
            ray.DrawText("c = " + view.ncr + " + " + view.nci + "i", 10, info1Y, 14, ray.SKYBLUE);
        } else if (view.isJulia) {
            ray.DrawText("JULIA  Scroll/Arrows: nav   I/U: iter   PgUp/PgDn: res   J: Mandelbrot   N: Newton   C: color cycle   R: reset   ESC: quit", 10, helpY, 14, ray.YELLOW);

            if (view.juliaLocked) {
                ray.DrawText("Click: unlock mouse tracking   [LOCKED]", 10, help2Y, 14, ray.ORANGE);
            } else {
                ray.DrawText("Mouse controls c   Click: lock", 10, help2Y, 14, ray.YELLOW);
            }
            ray.DrawText("c = " + view.jre + " + " + view.jim + "i", 10, info1Y, 14, ray.YELLOW);
        } else {
            ray.DrawText("MANDELBROT  Scroll/Arrows: nav   I/U: iter   PgUp/PgDn: res   R: reset   ESC: quit", 10, helpY, 14, ray.GRAY);
            ray.DrawText("J: Julia mode (mouse controls c)   N: Newton   C: color cycle", 10, help2Y, 14, ray.GRAY);
            ray.DrawText("c = " + view.jre + " + " + view.jim + "i", 10, info1Y, 14, ray.DARKGRAY);
        }
        if (view.colorCycle) {
            ray.DrawText("[COLOR CYCLE ON]", (width - 170), 10, 14, ray.LIME);
        }
        if (view.isJulia && view.juliaLocked) {
            ray.DrawText("[LOCKED]", (width - 90), 30, 14, ray.ORANGE);
        }
        if (view.isNewton && view.newtonLocked) {
            ray.DrawText("[LOCKED]", (width - 90), 30, 14, ray.ORANGE);
        }
        ray.DrawText("Re: " + view.cx, 10, infoY, 14, ray.DARKGRAY);
        ray.DrawText("Im: " + view.cy, 220, infoY, 14, ray.DARKGRAY);
        ray.DrawText("Zoom: " + view.zoom, 420, infoY, 14, ray.DARKGRAY);
        ray.DrawText("Iter: " + view.maxIter, 590, infoY, 14, ray.DARKGRAY);
        ray.DrawText("Step: " + view.step, 700, infoY, 14, ray.DARKGRAY);
        ray.EndDrawing();

        if (ray.IsKeyPressed(ray.KEY_ESCAPE)) {
            ray.CloseWindow();

            return;
        }
    }
    ray.UnloadRenderTexture(tex);
    ray.CloseWindow();
}
